# Production environment variables (names only — never commit real values).
# Copy to .env.local for local development and set values in the deployment platform for production.

# PostgreSQL connection string used by Drizzle ORM.
DATABASE_URL=
# Stripe secret key used to create checkout sessions and verify payments.
STRIPE_SECRET_KEY=
# Stripe webhook signing secret used to verify checkout.session.completed events.
STRIPE_WEBHOOK_SECRET=
# Comma-separated allowlist of admin emails for proof review.
ADMIN_EMAILS=
# Vercel Blob read/write token required for production video proof uploads.
BLOB_READ_WRITE_TOKEN=
# Secret used by Better Auth for session handling.
BETTER_AUTH_SECRET=
# Canonical base URL used by Better Auth (for example the production deployment URL).
BETTER_AUTH_URL=
